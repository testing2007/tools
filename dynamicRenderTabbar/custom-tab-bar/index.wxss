.tabbar-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  background: transparent;
  padding: 0 20rpx calc(env(safe-area-inset-bottom) + 18rpx);
}

.tabbar-card {
  position: relative;
  width: 100%;
  border-radius: 36rpx;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.76) 0%, rgba(255, 255, 255, 0.6) 100%),
    linear-gradient(135deg, rgba(255, 208, 160, 0.18) 0%, rgba(255, 255, 255, 0.02) 42%, rgba(255, 188, 117, 0.16) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  box-shadow:
    0 16rpx 40rpx rgba(30, 41, 59, 0.12),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(26rpx) saturate(140%);
  overflow: visible;
}

.tabbar-wrap {
  display: flex;
  align-items: center;
  min-height: 120rpx;
  padding: 10rpx 8rpx 0;
}

.tab-item {
  flex: 1;
  text-align: center;
  color: #8f95a3;
  font-size: 22rpx;
  line-height: 1.2;
  padding: 10rpx 4rpx 14rpx;
}

.tab-item-content {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 102rpx;
  padding: 12rpx 14rpx 10rpx;
  border-radius: 30rpx;
  transition: transform 220ms ease, background 220ms ease, box-shadow 220ms ease;
}

.tab-icon-shell {
  width: 64rpx;
  height: 64rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-item.active {
  color: #6e1f1f;
}

.tab-item.active .tab-item-content {
  transform: translateY(-12rpx);
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.92) 0%, rgba(255, 244, 233, 0.88) 100%);
  box-shadow:
    0 10rpx 24rpx rgba(255, 173, 96, 0.2),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.96);
}

.tab-item.active .tab-icon-shell {
  background: linear-gradient(180deg, #fff6ea 0%, #ffe3c7 100%);
  box-shadow: 0 8rpx 18rpx rgba(255, 170, 90, 0.24);
}

.center-ghost {
  opacity: 0;
}

.center-fab {
  position: absolute;
  left: 50%;
  top: -22rpx;
  transform: translateX(-50%);
  width: 136rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 10;
}

.center-fab-inner {
  width: 118rpx;
  height: 118rpx;
  border-radius: 38rpx;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(255, 245, 235, 0.94) 100%),
    linear-gradient(135deg, rgba(255, 214, 164, 0.34) 0%, rgba(255, 255, 255, 0) 100%);
  border: 10rpx solid rgba(255, 255, 255, 0.68);
  box-shadow:
    0 16rpx 32rpx rgba(30, 41, 59, 0.16),
    0 8rpx 20rpx rgba(255, 179, 94, 0.14);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 220ms ease, box-shadow 220ms ease;
}

.center-tab-icon {
  transform: scale(1.12);
}

.center-fab-label {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #8f95a3;
}

.center-fab.active .center-fab-inner {
  transform: translateY(-10rpx);
  box-shadow:
    0 18rpx 36rpx rgba(30, 41, 59, 0.2),
    0 10rpx 22rpx rgba(255, 168, 86, 0.26);
}

.center-fab.active .tab-icon,
.center-fab.active .center-fab-label {
  color: #6e1f1f;
}

.tabbar-card.mode-flat .tab-item {
  color: #70798a;
}

.tabbar-card.mode-flat .tab-item.active {
  color: #6e1f1f;
}

.tabbar-card.mode-flat .tabbar-wrap {
  padding-bottom: 2rpx;
}

.tab-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  font-weight: 500;
}

/* 图标统一使用 currentColor，选中态只需要改父级颜色即可整体变亮。 */
.tab-icon {
  position: relative;
  width: 40rpx;
  height: 40rpx;
  color: #8f95a3;
}

.tab-item.active .tab-icon,
.center-fab.active .tab-icon {
  color: #6e1f1f;
}

.tab-icon-home .icon-home,
.tab-icon-category .icon-category,
.tab-icon-discover .icon-discover,
.tab-icon-cart .icon-cart,
.tab-icon-profile .icon-profile {
  position: relative;
  width: 100%;
  height: 100%;
}

.icon-home-roof {
  position: absolute;
  left: 6rpx;
  top: 6rpx;
  width: 26rpx;
  height: 26rpx;
  border-left: 4rpx solid currentColor;
  border-top: 4rpx solid currentColor;
  transform: rotate(45deg);
  border-top-left-radius: 4rpx;
}

.icon-home-body {
  position: absolute;
  left: 10rpx;
  bottom: 4rpx;
  width: 20rpx;
  height: 16rpx;
  border: 4rpx solid currentColor;
  border-radius: 6rpx;
  background: rgba(255, 255, 255, 0.22);
}

.icon-category {
  display: flex;
  flex-wrap: wrap;
  gap: 4rpx;
  padding: 4rpx;
  box-sizing: border-box;
}

.icon-category-cell {
  width: 14rpx;
  height: 14rpx;
  border-radius: 5rpx;
  background: currentColor;
  opacity: 0.92;
}

.icon-discover-ring {
  position: absolute;
  left: 4rpx;
  top: 4rpx;
  width: 24rpx;
  height: 24rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
}

.icon-discover-dot {
  position: absolute;
  right: 2rpx;
  top: 2rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: currentColor;
  box-shadow: 0 0 0 4rpx rgba(255, 255, 255, 0.28);
}

.icon-cart-handle {
  position: absolute;
  left: 3rpx;
  top: 8rpx;
  width: 8rpx;
  height: 4rpx;
  border-top: 4rpx solid currentColor;
  border-left: 4rpx solid currentColor;
  border-top-left-radius: 6rpx;
}

.icon-cart-body {
  position: absolute;
  left: 9rpx;
  top: 11rpx;
  width: 20rpx;
  height: 14rpx;
  border: 4rpx solid currentColor;
  border-radius: 6rpx 6rpx 10rpx 10rpx;
  transform: skewX(-10deg);
}

.icon-cart-wheel {
  position: absolute;
  bottom: 2rpx;
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: currentColor;
}

.icon-cart-wheel.left {
  left: 12rpx;
}

.icon-cart-wheel.right {
  right: 6rpx;
}

.icon-profile-head {
  position: absolute;
  left: 11rpx;
  top: 3rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  border: 4rpx solid currentColor;
}

.icon-profile-shoulder {
  position: absolute;
  left: 5rpx;
  bottom: 3rpx;
  width: 28rpx;
  height: 14rpx;
  border: 4rpx solid currentColor;
  border-bottom: 0;
  border-radius: 18rpx 18rpx 0 0;
}
