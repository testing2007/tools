<view class="tabbar-shell">
  <view class="tabbar-card mode-{{shapeMode}}">
    <view class="tabbar-wrap">
      <view
        wx:for="{{visibleTabs}}"
        wx:key="pagePath"
        class="tab-item {{selectedPath === item.fullPath ? 'active' : ''}} {{item.isCenter && shapeMode === 'floating' ? 'center-ghost' : ''}}"
        data-path="{{item.tapPath}}"
        bindtap="onTabTap"
      >
        <view class="tab-item-content">
          <view class="tab-icon-shell">
            <view class="tab-icon tab-icon-{{item.iconType}}">
              <view wx:if="{{item.iconType === 'home'}}" class="icon-home">
                <view class="icon-home-roof"></view>
                <view class="icon-home-body"></view>
              </view>
              <view wx:elif="{{item.iconType === 'category'}}" class="icon-category">
                <view class="icon-category-cell"></view>
                <view class="icon-category-cell"></view>
                <view class="icon-category-cell"></view>
                <view class="icon-category-cell"></view>
              </view>
              <view wx:elif="{{item.iconType === 'discover'}}" class="icon-discover">
                <view class="icon-discover-ring"></view>
                <view class="icon-discover-dot"></view>
              </view>
              <view wx:elif="{{item.iconType === 'cart'}}" class="icon-cart">
                <view class="icon-cart-handle"></view>
                <view class="icon-cart-body"></view>
                <view class="icon-cart-wheel left"></view>
                <view class="icon-cart-wheel right"></view>
              </view>
              <view wx:elif="{{item.iconType === 'profile'}}" class="icon-profile">
                <view class="icon-profile-head"></view>
                <view class="icon-profile-shoulder"></view>
              </view>
            </view>
          </view>
          <text class="tab-label">{{item.text}}</text>
        </view>
      </view>
    </view>

    <view
      wx:if="{{shapeMode === 'floating' && centerTab}}"
      class="center-fab {{selectedPath === centerTab.fullPath ? 'active' : ''}}"
      data-path="{{centerTab.fullPath}}"
      bindtap="onTabTap"
    >
      <view class="center-fab-inner">
        <view class="tab-icon tab-icon-{{centerTab.iconType}} center-tab-icon">
          <view wx:if="{{centerTab.iconType === 'home'}}" class="icon-home">
            <view class="icon-home-roof"></view>
            <view class="icon-home-body"></view>
          </view>
          <view wx:elif="{{centerTab.iconType === 'category'}}" class="icon-category">
            <view class="icon-category-cell"></view>
            <view class="icon-category-cell"></view>
            <view class="icon-category-cell"></view>
            <view class="icon-category-cell"></view>
          </view>
          <view wx:elif="{{centerTab.iconType === 'discover'}}" class="icon-discover">
            <view class="icon-discover-ring"></view>
            <view class="icon-discover-dot"></view>
          </view>
          <view wx:elif="{{centerTab.iconType === 'cart'}}" class="icon-cart">
            <view class="icon-cart-handle"></view>
            <view class="icon-cart-body"></view>
            <view class="icon-cart-wheel left"></view>
            <view class="icon-cart-wheel right"></view>
          </view>
          <view wx:elif="{{centerTab.iconType === 'profile'}}" class="icon-profile">
            <view class="icon-profile-head"></view>
            <view class="icon-profile-shoulder"></view>
          </view>
        </view>
      </view>
      <text class="center-fab-label">{{centerTab.text}}</text>
    </view>
  </view>
</view>
