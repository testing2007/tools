page {
  background: #f5f6f8;
}

.container {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.title {
  font-size: 36rpx;
  font-weight: 600;
}

.sub-title {
  margin-top: 12rpx;
  color: #666666;
  font-size: 28rpx;
}

.button {
  margin-top: 24rpx;
  background: #1677ff;
  color: #ffffff;
  border-radius: 12rpx;
}
