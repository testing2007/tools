<!--
  index.wxml  v7.1 — 数据驱动渲染
  
  · 所有内容从 data.groups 动态生成，无硬编码
  · 三层 wx:for：groups → images → overlays
  · 浮层类型（tag/card/main）用 wx:if 按 ov.type 分支渲染
  · animMap[img.id] 动态查询每张图片的动画状态
  · 新增一组只需改 productConfig.js，此文件无需动
-->

<view class="viewport">

  <!-- 外层轨道：outerY 控制哪组在视口中 -->
  <view class="outer-track"
    style="transform:translateY({{outerY}}px); transition:{{outerEase}};"
  >

    <!--
      第一层 wx:for: 遍历所有组
        · gidx = 组序号（0, 1, 2…）
        · group = { images: [...] }
        · catchtouchmove 在这里，JS 完全控制触摸
        · data-gidx 传给事件处理器，让 onGStart/Move/End 知道哪个组在响应
    -->
    <view
      wx:for="{{groups}}"
      wx:key="index"
      wx:for-index="gidx"
      wx:for-item="group"
      class="group-screen"
      catchtouchstart="onGStart"
      catchtouchmove="onGMove"
      catchtouchend="onGEnd"
      data-gidx="{{gidx}}"
    >
      <!-- 内层内容：groupY[gidx] 控制组内滚动偏移 -->
      <view
        class="group-content"
        id="gc-{{gidx}}"
        style="transform:translateY({{groupY[gidx]}}px); transition:{{groupEase[gidx]}};"
      >

        <!--
          第二层 wx:for: 遍历该组的所有图片
            · img = { id, src, overlays: [...] }
        -->
        <view
          wx:for="{{group.images}}"
          wx:key="id"
          wx:for-item="img"
          wx:for-index="imgIdx"
          class="img-row"
          id="{{img.id}}"
        >
          <image class="w-img" src="{{img.src}}" mode="widthFix"></image>

          <!--
            第三层 wx:for: 遍历该图片的所有浮层
              · ov = { type, dir, anchor, ...type-specific fields }
              · animMap[img.id] 动态查询该图片的动画状态（initial/visible/exiting）
          -->
          <view
            wx:for="{{img.overlays}}"
            wx:key="index"
            wx:for-item="ov"
            class="pos-anchor pos-{{ov.anchor}}"
          >
            <view class="fov dir-{{ov.dir}} state-{{animMap[img.id]}}">

              <!-- type = tag：小胶囊标签 -->
              <view wx:if="{{ov.type === 'tag'}}" class="f-tag">
                <text class="f-icon">{{ov.icon}}</text>
                <text class="f-txt">{{ov.label}}</text>
              </view>

              <!-- type = card：信息卡片 -->
              <view wx:if="{{ov.type === 'card'}}" class="f-card">
                <text class="f-eyebrow">{{ov.eyebrow}}</text>
                <text class="f-title">{{ov.title}}</text>
                <text class="f-desc">{{ov.desc}}</text>
              </view>

              <!-- type = main：大号主推卡片（含按钮） -->
              <view wx:if="{{ov.type === 'main'}}" class="f-main">
                <text class="f-eyebrow">{{ov.eyebrow}}</text>
                <text class="f-title">{{ov.title}}</text>
                <text class="f-desc">{{ov.desc}}</text>
                <view class="f-btn">
                  <text>{{ov.btnText}}</text>
                  <text> →</text>
                </view>
              </view>

            </view>
          </view>
          <!-- /overlays -->

        </view>
        <!-- /img-row -->

      </view>
      <!-- /group-content -->
    </view>
    <!-- /group-screen -->

  </view>
  <!-- /outer-track -->

  <!-- 弹簧进度提示（仅在弹簧区且进度 > 8% 时显示） -->
  <view
    wx:if="{{springProg > 8}}"
    class="spring-tip {{currentGroup < groups.length - 1 && springDir === 'next' ? 'tip-bot' : 'tip-top'}}"
  >
    <text class="spring-tip-txt">{{springDir === 'next' ? '↑ 上滑进入下一组' : '↓ 下滑返回上一组'}}</text>
    <view class="spring-tip-bar">
      <view class="spring-tip-fill" style="width:{{springProg}}%;"></view>
    </view>
  </view>

</view>
<!-- /viewport -->

<!-- 右侧分组指示器：点数由 groups 长度决定，无需手动维护 -->
<view class="dots">
  <view
    wx:for="{{groups}}"
    wx:key="index"
    wx:for-index="gidx"
    class="dot {{currentGroup === gidx ? 'dot-on' : ''}}"
  ></view>
</view>
