/* ================================================================
   index.wxss  v4  ——  Custom Touch Physics Layout
   
   关键结构：
   · .viewport  → 100vh 固定视口，overflow:hidden
   · .track     → 实际内容轨道，transform:translateY 驱动
   · .slide     → 每个全屏卡片，100vh
   ================================================================ */

page {
  height: 100vh;
  margin: 0;
  padding: 0;
  overflow: hidden;
  background: #000;
}

/* ── 视口：固定大小，隐藏超出范围的内容 ── */
.viewport {
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  position: relative;
  background: #000;
}

/* ── 轨道：通过 transform:translateY 移动 ── */
.track {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  /* transition 通过 inline style 动态控制 */
}

/* ── 通用 Slide 基类 ── */
.slide {
  width: 100%;
  height: 100vh;
  position: relative;
  overflow: hidden;
}

/* ================================================================
   图片展示屏
   ================================================================ */
.slide-image .slide-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.slide-gradient {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 55%;
  background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, transparent 100%);
  z-index: 10;
  pointer-events: none;
}

.slide-badge {
  position: absolute;
  bottom: 30rpx;
  right: 32rpx;
  z-index: 30;
  font-size: 22rpx;
  color: rgba(255,255,255,0.4);
  letter-spacing: 4rpx;
}

/* ================================================================
   位置锚点：只负责定位，不参与动画 transform
   ================================================================ */
.pos-anchor {
  position: absolute;
  z-index: 20;
}
.pos-anchor.pos-top-left   { top: 14%; left: 5%; }
.pos-anchor.pos-top-right  { top: 14%; right: 5%; }
.pos-anchor.pos-mid-right  { top: 33%; right: 5%; }
.pos-anchor.pos-mid-left   { top: 33%; left: 5%; }
/* 底部居中用 flexbox，避免 left:50%+translateX 与动画 transform 冲突 */
.pos-anchor.pos-bot-center {
  bottom: 12%;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
}

/* ================================================================
   浮层动画层 (float-overlay)
   三态状态机：
     state-initial  → 偏移到屏幕外（opacity:0）
     state-visible  → 归位（opacity:1）
     state-exiting  → 偏移到屏幕对侧外（opacity:0）
   CSS transition 自动补间，完全可逆
   ================================================================ */
.float-overlay {
  transition:
    transform 0.65s cubic-bezier(0.16, 1, 0.3, 1),
    opacity   0.65s ease;
  will-change: transform, opacity;
}

/* 从左飞入 → 逆向时向右飞出 */
.float-overlay.dir-left.state-initial { transform: translateX(-420px); opacity: 0; }
.float-overlay.dir-left.state-visible { transform: translateX(0);      opacity: 1; }
.float-overlay.dir-left.state-exiting { transform: translateX(420px);  opacity: 0; }

/* 从右飞入 → 逆向时向左飞出 */
.float-overlay.dir-right.state-initial { transform: translateX(420px);  opacity: 0; }
.float-overlay.dir-right.state-visible { transform: translateX(0);      opacity: 1; }
.float-overlay.dir-right.state-exiting { transform: translateX(-420px); opacity: 0; }

/* 从下弹出 → 逆向时向上退出 */
.float-overlay.dir-bottom.state-initial { transform: translateY(300px);  opacity: 0; }
.float-overlay.dir-bottom.state-visible { transform: translateY(0);      opacity: 1; }
.float-overlay.dir-bottom.state-exiting { transform: translateY(-250px); opacity: 0; }

/* ================================================================
   浮层视觉样式
   ================================================================ */

/* 标签型：圆角胶囊 */
.f-tag {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 44rpx;
  border-radius: 100rpx;
  background: rgba(255,255,255,0.93);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  box-shadow: 0 6rpx 32rpx rgba(0,0,0,0.25),
              inset 0 1rpx 0 rgba(255,255,255,0.9);
  white-space: nowrap;
}
.f-tag-icon  { font-size: 34rpx; line-height: 1; }
.f-tag-label { font-size: 28rpx; font-weight: 700; color: #111; letter-spacing: 2rpx; }

/* 信息卡片型 */
.f-card {
  width: 290rpx;
  padding: 34rpx 36rpx;
  border-radius: 24rpx;
  background: rgba(255,255,255,0.96);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  box-shadow: 0 12rpx 50rpx rgba(0,0,0,0.4),
              inset 0 1rpx 0 rgba(255,255,255,1);
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.f-card-eyebrow { font-size: 19rpx; letter-spacing: 5rpx; color: rgba(0,0,0,0.32); }
.f-card-title   { font-size: 36rpx; font-weight: 800; color: #111; line-height: 1.2; }
.f-card-desc    { font-size: 24rpx; color: #666; line-height: 1.65; }

/* 底部大卡片型 */
.f-main {
  width: 640rpx;
  padding: 48rpx 44rpx;
  border-radius: 32rpx;
  background: rgba(255,255,255,0.97);
  backdrop-filter: blur(30px);
  -webkit-backdrop-filter: blur(30px);
  box-shadow: 0 16rpx 80rpx rgba(0,0,0,0.55);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  text-align: center;
}
.f-main-eyebrow { font-size: 20rpx; letter-spacing: 6rpx; color: rgba(0,0,0,0.33); }
.f-main-title   { font-size: 48rpx; font-weight: 900; color: #111; letter-spacing: 3rpx; }
.f-main-desc    { font-size: 26rpx; color: #666; line-height: 1.65; }
.f-main-btn {
  display: flex; align-items: center; gap: 12rpx;
  margin-top: 16rpx;
  padding: 22rpx 64rpx;
  border-radius: 100rpx;
  background: linear-gradient(135deg, #1a1a2e, #0f3460);
  color: #fff; font-size: 28rpx; font-weight: 700; letter-spacing: 4rpx;
}
.f-main-arrow { font-size: 28rpx; }

/* ================================================================
   组过渡分隔屏
   ================================================================ */
.slide-transition {
  background: #07071a;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.tr-bg {
  position: absolute; top: 0; left: 0; right: 0; bottom: 0;
  background:
    radial-gradient(ellipse at 25% 35%, rgba(90,40,180,0.28) 0%, transparent 55%),
    radial-gradient(ellipse at 75% 70%, rgba(20,70,170,0.22) 0%, transparent 55%),
    linear-gradient(150deg, #07071e 0%, #0e0e30 50%, #081422 100%);
}

/* 细线装饰 */
.tr-noise {
  position: absolute; top: 0; left: 0; right: 0; bottom: 0;
  background: repeating-linear-gradient(
    90deg, transparent 0, transparent 98rpx,
    rgba(255,255,255,0.016) 98rpx, rgba(255,255,255,0.016) 100rpx
  );
  pointer-events: none;
}

.tr-content {
  position: relative; z-index: 5;
  display: flex; flex-direction: column; align-items: center;
  gap: 26rpx; padding: 0 60rpx; text-align: center;
}
.tr-eyebrow { font-size: 20rpx; letter-spacing: 10rpx; color: rgba(255,255,255,0.38); }
.tr-line {
  width: 60rpx; height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
}
.tr-title  { font-size: 74rpx; font-weight: 900; color: #fff; letter-spacing: 5rpx; }
.tr-desc   { font-size: 26rpx; color: rgba(255,255,255,0.48); line-height: 1.7; letter-spacing: 2rpx; }

/* 底部提示 */
.tr-hint {
  position: absolute; bottom: 10%; left: 0; right: 0; z-index: 5;
  display: flex; flex-direction: column; align-items: center; gap: 10rpx;
}
.tr-hint-text  { font-size: 22rpx; letter-spacing: 4rpx; color: rgba(255,255,255,0.28); }
.tr-hint-arrow {
  font-size: 30rpx; color: rgba(255,255,255,0.38);
  animation: bounce-down 1.8s ease-in-out infinite;
}
@keyframes bounce-down {
  0%,100% { transform: translateY(0); opacity: 0.38; }
  50%      { transform: translateY(14rpx); opacity: 0.75; }
}

/* 阻力进度条：显示用户当前拉力（需要到 100% 才能通过） */
.tr-progress {
  position: absolute; bottom: 0; left: 0; right: 0; z-index: 6;
  height: 4rpx;
  background: rgba(255,255,255,0.08);
}
.tr-progress-bar {
  height: 100%;
  background: linear-gradient(90deg, #7b5ea7, #4e86c8);
  transition: width 0.1s linear;
  border-radius: 100rpx;
}

/* ================================================================
   右侧分组指示器
   ================================================================ */
.group-dots {
  position: fixed; right: 28rpx; top: 50%; transform: translateY(-50%);
  z-index: 100; display: flex; flex-direction: column; align-items: center; gap: 14rpx;
}
.g-dot {
  width: 8rpx; height: 8rpx; border-radius: 50%;
  background: rgba(255,255,255,0.28);
  transition: all 0.4s cubic-bezier(0.16,1,0.3,1);
}
.g-dot-mid { width: 6rpx; height: 6rpx; background: rgba(255,255,255,0.16); }
.g-dot-active { background: #fff; height: 36rpx; border-radius: 6rpx; }
.g-dot-trans  { background: rgba(140,100,255,0.75); box-shadow: 0 0 12rpx rgba(140,100,255,0.5); }

/* ================================================================
   顶部分组标签
   ================================================================ */
.group-label {
  position: fixed; top: 60rpx; left: 50%; transform: translateX(-50%);
  z-index: 100;
  font-size: 22rpx; letter-spacing: 6rpx; white-space: nowrap;
  color: rgba(255,255,255,0); opacity: 0;
  background: rgba(255,255,255,0.1);
  backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
  padding: 12rpx 36rpx; border-radius: 100rpx;
  border: 1rpx solid rgba(255,255,255,0.14);
  transition: color 0.5s ease, opacity 0.5s ease;
  pointer-events: none;
}
.group-label.group-label-show {
  color: rgba(255,255,255,0.85); opacity: 1;
}
