<view class="viewport">
  <view class="outer-track" style="transform:translateY({{outerY}}px); transition:{{outerEase}};">
    <view
      wx:for="{{groups}}"
      wx:key="index"
      wx:for-index="gidx"
      wx:for-item="group"
      class="group-screen"
      catchtouchstart="onGStart"
      catchtouchmove="onGMove"
      catchtouchend="onGEnd"
      data-gidx="{{gidx}}"
    >
      <view class="group-content" id="gc-{{gidx}}" style="transform:translateY({{groupY[gidx]}}px);">
        <view
          wx:for="{{group.images}}"
          wx:key="id"
          wx:for-item="img"
          wx:for-index="imgIdx"
          class="img-row"
          id="{{img.id}}"
        >
          <image
            class="w-img"
            src="{{img.src}}"
            mode="widthFix"
            bindload="onImgLoad"
            binderror="onImgLoad"
            data-gidx="{{gidx}}"
            data-imgidx="{{imgIdx}}"
          ></image>

          <view
            wx:for="{{img.overlays}}"
            wx:key="index"
            wx:for-item="ov"
            class="pos-anchor"
            style="{{ov._anchorStyle}}"
          >
            <view class="fov" style="{{ov._dynamicStyle}}">
              <view
                wx:if="{{ov.type === 'tag'}}"
                class="f-tag"
                style="color:{{ov.style.color}}; font-size:{{ov.style.fontSize/2}}px; font-weight:{{ov.style.fontWeight}}; background-color:{{ov.style.bgColor}}; {{ov.style.bgBlur ? 'backdrop-filter:blur(10px);' : ''}} {{ov.style.boxShadow === false ? 'box-shadow:none;' : ''}}"
              >
                <text class="f-icon">{{ov.icon}}</text>
                <text class="f-txt">{{ov.label}}</text>
              </view>

              <view
                wx:if="{{ov.type === 'card'}}"
                class="f-card"
                style="color:{{ov.style.color}}; background-color:{{ov.style.bgColor}}; {{ov.style.bgBlur ? 'backdrop-filter:blur(20px);' : ''}} {{ov.style.boxShadow === false ? 'box-shadow:none;' : ''}}"
              >
                <text class="f-eyebrow" style="font-size:{{ov.style.fontSize*0.3}}px">{{ov.eyebrow}}</text>
                <text class="f-title" style="font-size:{{ov.style.fontSize*0.6}}px; font-weight:{{ov.style.fontWeight}}">{{ov.title}}</text>
                <text class="f-desc" style="font-size:{{ov.style.fontSize*0.42}}px">{{ov.desc}}</text>
              </view>

              <view
                wx:if="{{ov.type === 'main'}}"
                class="f-main"
                style="color:{{ov.style.color}}; background-color:{{ov.style.bgColor}}; {{ov.style.bgBlur ? 'backdrop-filter:blur(30px);' : ''}} {{ov.style.boxShadow === false ? 'box-shadow:none;' : ''}}"
              >
                <text class="f-eyebrow" style="font-size:{{ov.style.fontSize*0.3}}px">{{ov.eyebrow}}</text>
                <text class="f-title" style="font-size:{{ov.style.fontSize*0.65}}px; font-weight:{{ov.style.fontWeight}}">{{ov.title}}</text>
                <text class="f-desc" style="font-size:{{ov.style.fontSize*0.42}}px">{{ov.desc}}</text>
                <view class="f-btn">
                  <text>{{ov.btnText}}</text>
                  <text> -> </text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view
    wx:if="{{springProg > 8}}"
    class="spring-tip {{currentGroup < groups.length - 1 && springDir === 'next' ? 'tip-bot' : 'tip-top'}}"
  >
    <text class="spring-tip-txt">{{springDir === 'next' ? '↑ 上滑进入下一组' : '↓ 下滑返回上一组'}}</text>
    <view class="spring-tip-bar">
      <view class="spring-tip-fill" style="width:{{springProg}}%;"></view>
    </view>
  </view>
</view>

<view class="dots">
  <view
    wx:for="{{groups}}"
    wx:key="index"
    wx:for-index="gidx"
    class="dot {{currentGroup === gidx ? 'dot-on' : ''}}"
  ></view>
</view>
