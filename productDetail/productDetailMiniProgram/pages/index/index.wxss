/* ================================================================
   index.wxss  v7
   
   视觉层次：
   - .viewport        100vh，overflow:hidden，裁剪所有超出内容
   - .outer-track     两组纵向排列（总高 200vh），transform 切换
   - .group-screen    每组固定 100vh，overflow:hidden
   - .group-content   自然高度，transform 控制组内滚动
   ================================================================ */

page { margin:0; padding:0; height:100vh; overflow:hidden; background:#000; }

/* ── 1. 基础布局 ── */

.viewport {
  width:100vw;
  height:100vh;
  overflow:hidden;
  position:relative;
  background:#1a1a1a; /* 非黑背景，防止切组瞬间露出 */
}

/* 两组纵向堆叠，总高 200vh；通过 outerY transform 决定哪组可见 */
.outer-track {
  position:absolute;
  top:0; left:0;
  width:100%;
  /* transition 通过 inline style 动态控制，EASE_NONE / EASE_SWITCH / EASE_SPRING */
}

/* 每组容器：固定 100vh，裁剪组内超出内容 */
.group-screen {
  width:100%;
  height:100vh;
  overflow:hidden;
  position:relative;
  background:#1a1a1a;
}

/* 组内容：自然高度（图片叠加），translateY 控制滚动 */
.group-content {
  position:relative;
  width:100%;
  /* transition 通过 inline style 动态控制 */
}

/* ── 2. 图片 ── */

.img-row {
  position:relative;
  width:100%;
  font-size:0; /* 消除 inline 间距 */
}

.w-img {
  width:100%;
  display:block;
}

/* ── 3. 弹簧进度提示 ── */

.spring-tip {
  position:fixed;
  left:0; right:0;
  z-index:200;
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:10rpx;
  padding:18rpx 40rpx;
  background:rgba(0,0,0,0.5);
  backdrop-filter:blur(10px);
}

.spring-tip.tip-bot { bottom:0; border-radius:24rpx 24rpx 0 0; }
.spring-tip.tip-top { top:0;    border-radius:0 0 24rpx 24rpx; }

.spring-tip-txt {
  font-size:22rpx;
  color:rgba(255,255,255,.7);
  letter-spacing:3rpx;
}

.spring-tip-bar {
  width:200rpx;
  height:4rpx;
  background:rgba(255,255,255,.15);
  border-radius:100rpx;
  overflow:hidden;
}

.spring-tip-fill {
  height:100%;
  background:linear-gradient(90deg,#7b5ea7,#4e86c8);
  border-radius:100rpx;
  transition:width .08s linear;
}

/* ── 4. 浮层锚点 ── */

.pos-anchor { position:absolute; z-index:20; }
.pos-anchor.pos-top-left   { top:12%;    left:5%;  }
.pos-anchor.pos-top-right  { top:12%;    right:5%; }
.pos-anchor.pos-mid-right  { top:30%;    right:5%; }
.pos-anchor.pos-mid-left   { top:30%;    left:5%;  }
/* 底部居中：用 flex 居中，避免 translateX 与 .fov 的 translateX 动画叠加冲突 */
.pos-anchor.pos-bot-center {
  bottom:10%;
  left:0; right:0;
  display:flex;
  justify-content:center;
}

/* ── 5. 浮层动画：三态状态机 ── */
/*
  initial  → 等待进入视口（起始藏匿位置）
  visible  → 已进入视口（目标位置，飞入完成）
  exiting  → 用户往回滑，逆向退场
  initial  → exiting 动画结束后重置（供下次重用）
*/

.fov {
  transition:
    transform .65s cubic-bezier(.16,1,.3,1),
    opacity   .65s ease;
  will-change: transform, opacity;
}

/* 从左飞入；逆向时向右飞出 */
.fov.dir-left.state-initial { transform:translateX(-400px); opacity:0; }
.fov.dir-left.state-visible { transform:translateX(0);      opacity:1; }
.fov.dir-left.state-exiting { transform:translateX(400px);  opacity:0; }

/* 从右飞入；逆向时向左飞出 */
.fov.dir-right.state-initial { transform:translateX(400px);  opacity:0; }
.fov.dir-right.state-visible { transform:translateX(0);      opacity:1; }
.fov.dir-right.state-exiting { transform:translateX(-400px); opacity:0; }

/* 从下弹出；逆向时向上退出 */
.fov.dir-bottom.state-initial { transform:translateY(280px);  opacity:0; }
.fov.dir-bottom.state-visible { transform:translateY(0);      opacity:1; }
.fov.dir-bottom.state-exiting { transform:translateY(-200px); opacity:0; }

/* ── 6. 浮层视觉样式 ── */

.f-tag {
  display:flex; align-items:center; gap:12rpx;
  padding:20rpx 44rpx; border-radius:100rpx;
  background:rgba(255,255,255,.93);
  backdrop-filter:blur(20px);
  box-shadow:0 6rpx 32rpx rgba(0,0,0,.28);
  white-space:nowrap;
}
.f-icon { font-size:34rpx; }
.f-txt  { font-size:28rpx; font-weight:700; color:#111; letter-spacing:2rpx; }

.f-card {
  width:290rpx; padding:32rpx; border-radius:24rpx;
  background:rgba(255,255,255,.96);
  backdrop-filter:blur(20px);
  box-shadow:0 12rpx 50rpx rgba(0,0,0,.4);
  display:flex; flex-direction:column; gap:10rpx;
}
.f-eyebrow { font-size:19rpx; letter-spacing:5rpx; color:rgba(0,0,0,.3); }
.f-title   { font-size:36rpx; font-weight:800; color:#111; }
.f-desc    { font-size:24rpx; color:#666; line-height:1.65; }

.f-main {
  width:620rpx; padding:44rpx; border-radius:32rpx;
  background:rgba(255,255,255,.97);
  backdrop-filter:blur(30px);
  box-shadow:0 16rpx 80rpx rgba(0,0,0,.55);
  display:flex; flex-direction:column; align-items:center;
  gap:14rpx; text-align:center;
}
.f-btn {
  display:flex; align-items:center; gap:12rpx;
  margin-top:12rpx; padding:22rpx 60rpx;
  border-radius:100rpx;
  background:linear-gradient(135deg,#1a1a2e,#0f3460);
  color:#fff; font-size:28rpx; font-weight:700;
}

/* ── 7. 右侧分组指示器 ── */

.dots {
  position:fixed; right:28rpx; top:50%;
  transform:translateY(-50%);
  z-index:300;
  display:flex; flex-direction:column; gap:16rpx;
}

.dot {
  width:8rpx; height:8rpx;
  border-radius:50%;
  background:rgba(255,255,255,.3);
  transition:all .4s cubic-bezier(.16,1,.3,1);
}

.dot-on {
  background:#fff;
  height:36rpx;
  border-radius:6rpx;
}
