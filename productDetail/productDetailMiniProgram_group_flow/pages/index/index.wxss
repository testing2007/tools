/* index.wxss  v9.0 */

page {
  overflow: hidden;
  height: 100vh;
  background: #000;
}

.viewport {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  overflow: hidden;
  z-index: 1;
}

/* 统一轨道：所有图片纵向排列 */
.track {
  position: absolute;
  top: 0; left: 0;
  width: 100%;
  will-change: transform;
}

/* 每张图片占一个视口 */
.img-row {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
}

.w-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* ---- 浮层定位 ---- */
.pos-anchor {
  position: absolute;
  z-index: 10;
  pointer-events: none;
}

.fov {
  will-change: transform, opacity;
}

/* ---- 浮层类型样式 ---- */
.f-tag {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  white-space: nowrap;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.10);
}
.f-icon { margin-right: 4rpx; }
.f-txt  { white-space: nowrap; }

.f-card {
  display: flex;
  flex-direction: column;
  padding: 20rpx 28rpx;
  border-radius: 20rpx;
  min-width: 240rpx;
  max-width: 420rpx;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.12);
}
.f-eyebrow {
  opacity: 0.6;
  margin-bottom: 4rpx;
}
.f-title {
  margin-bottom: 6rpx;
  line-height: 1.25;
}
.f-desc {
  opacity: 0.7;
  line-height: 1.4;
}

.f-main {
  display: flex;
  flex-direction: column;
  padding: 28rpx 36rpx;
  border-radius: 24rpx;
  min-width: 300rpx;
  max-width: 520rpx;
  box-shadow: 0 8rpx 40rpx rgba(0,0,0,0.18);
}
.f-main .f-eyebrow { opacity: 0.65; margin-bottom: 6rpx; }
.f-main .f-title   { margin-bottom: 8rpx; line-height: 1.2; }
.f-main .f-desc    { opacity: 0.75; line-height: 1.4; margin-bottom: 16rpx; }

.f-btn {
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.2);
  font-size: 24rpx;
  font-weight: 600;
}

/* ---- 弹簧提示 ---- */
.spring-tip {
  position: fixed;
  left: 50%;
  transform: translateX(-50%);
  z-index: 100;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  pointer-events: none;
}
.tip-bot { bottom: 60rpx; }
.tip-top { top: 60rpx; }

.spring-tip-txt {
  font-size: 22rpx;
  color: rgba(255,255,255,0.7);
}
.spring-tip-bar {
  width: 160rpx;
  height: 4rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 2rpx;
  overflow: hidden;
}
.spring-tip-fill {
  height: 100%;
  background: rgba(255,255,255,0.8);
  border-radius: 2rpx;
  transition: width 0.05s linear;
}

/* ---- 分组指示器 ---- */
.dots {
  position: fixed;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  z-index: 200;
}
.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.3);
  transition: all 0.3s ease;
}
.dot-on {
  background: #fff;
  transform: scale(1.4);
}