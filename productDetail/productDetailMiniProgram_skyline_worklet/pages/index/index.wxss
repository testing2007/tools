/* ================================================================
   index.wxss (Skyline Worklet Version)
   ================================================================ */

page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f8f8f8;
  color: #333;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
}

/* ── 1. 滚动容器 ── */
.scroll-container {
  width: 100vw;
  height: 100vh;
  flex: 1;
}

/* ── 2. 顶部大图 ── */
.hero-section {
  width: 100vw;
  height: 177.78vw; /* 16:9 比例 (16/9 * 100) */
  overflow: hidden;
  position: relative;
  background-color: #000; /* 防止底色露出 */
}

.hero-image {
  width: 100%;
  height: 100%;
  display: block;
}

/* ── 3. 商品信息区域 ── */
.goods-info {
  background: #fff;
  padding: 40rpx 32rpx;
  border-radius: 40rpx 40rpx 0 0;
  margin-top: -40rpx;
  position: relative;
  z-index: 10;
  box-shadow: 0 -20rpx 40rpx rgba(0,0,0,0.05);
}

.price-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 24rpx;
}

.price {
  font-size: 56rpx;
  font-weight: 700;
  color: #ff4d4f;
  margin-right: 16rpx;
}

.original-price {
  font-size: 28rpx;
  color: #999;
  text-decoration: line-through;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.4;
  margin-bottom: 16rpx;
  color: #1a1a1a;
}

.desc {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

/* ── 4. 详情区域 ── */
.detail-section {
  padding: 40rpx 32rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
  padding-left: 16rpx;
  border-left: 8rpx solid #1a1a1a;
}

/* ── 5. 浮动导航栏 ── */
.float-nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  padding-top: env(safe-area-inset-top);
  opacity: 0; /* 初始隐藏，由 JS 控制 */
}

.nav-inner {
  height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #1a1a1a;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
  margin-right: 64rpx;
  color: #1a1a1a;
}

/* ── 6. 底部操作栏 ── */
.float-bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 100;
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20px);
  border-top: 1rpx solid rgba(0,0,0,0.05);
  transform: translateY(100%); /* 初始隐藏 */
}

.bar-inner {
  height: 112rpx;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  gap: 20rpx;
}

.bar-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
}

.bar-btn--cart {
  background: #f0f0f0;
  color: #1a1a1a;
}

.bar-btn--buy {
  background: #1a1a1a;
  color: #fff;
}

/* ── 7. 回到顶部 ── */
.float-back-top {
  position: fixed;
  right: 40rpx;
  bottom: 200rpx;
  width: 88rpx;
  height: 88rpx;
  background: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.1);
  z-index: 90;
  opacity: 0;
  transform: scale(0.5);
}

