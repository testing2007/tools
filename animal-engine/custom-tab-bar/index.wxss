.demo-tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 80;
  padding: 0 22rpx calc(18rpx + env(safe-area-inset-bottom));
  pointer-events: none;
}

.demo-tabbar__panel {
  position: relative;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  min-height: 118rpx;
  padding: 12rpx 0 10rpx;
  overflow: hidden;
  border: 1rpx solid rgba(113, 84, 65, 0.12);
  border-radius: 34rpx;
  background: rgba(255, 250, 246, 0.98);
  box-shadow: 0 -10rpx 34rpx rgba(84, 52, 35, 0.12);
  pointer-events: auto;
}

.demo-tabbar__indicator {
  position: absolute;
  left: 0;
  top: 10rpx;
  width: 25%;
  height: 88rpx;
  border-radius: 28rpx;
  background: linear-gradient(180deg, rgba(255, 239, 225, 0.92), rgba(248, 218, 194, 0.72));
  transition: transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
}

.demo-tabbar__item {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  color: #8e776a;
}

.demo-tabbar__icon-wrap {
  position: relative;
  width: 52rpx;
  height: 52rpx;
  transform: translate3d(0, 0, 0) scale(1);
  transition: transform 180ms ease;
}

.demo-tabbar__icon {
  width: 52rpx;
  height: 52rpx;
}

.demo-tabbar__text {
  font-size: 20rpx;
  line-height: 1.1;
  transition: color 180ms ease, transform 180ms ease;
}

.demo-tabbar__badge {
  position: absolute;
  right: -16rpx;
  top: -10rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: #a84d31;
  color: #fff8f3;
  font-size: 18rpx;
  line-height: 30rpx;
  text-align: center;
}

.is-active {
  color: #a84d31;
}

.is-active .demo-tabbar__icon-wrap {
  transform: translate3d(0, -8rpx, 0) scale(1.12);
  animation: tabPop 260ms ease both;
}

.is-active .demo-tabbar__text {
  transform: translate3d(0, -4rpx, 0);
  color: #a84d31;
  font-weight: 700;
}

.is-bouncing .demo-tabbar__icon-wrap {
  animation: cartBounce 360ms ease both;
}

@keyframes tabPop {
  0% {
    transform: translate3d(0, 0, 0) scale(0.92);
  }

  62% {
    transform: translate3d(0, -10rpx, 0) scale(1.16);
  }

  100% {
    transform: translate3d(0, -8rpx, 0) scale(1.12);
  }
}

@keyframes cartBounce {
  0%,
  100% {
    transform: translate3d(0, -8rpx, 0) scale(1.12);
  }

  45% {
    transform: translate3d(0, -14rpx, 0) scale(1.28);
  }
}
